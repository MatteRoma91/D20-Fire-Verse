<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FireVerse.Heading" parent="">
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FireVerse.Button" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/button_table</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
