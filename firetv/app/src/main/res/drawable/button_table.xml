<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFC4622D" android:endColor="#FF8E3B17" />
            <stroke android:width="2dp" android:color="@color/gold" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF8E3B17" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26F1C46B" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
