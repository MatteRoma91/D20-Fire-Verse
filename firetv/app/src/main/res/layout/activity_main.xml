<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/connect"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/connectArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.55"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/connect_art" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/connect_scrim" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/panel"
                android:layout_width="640dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="40dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:paddingHorizontal="36dp"
                android:paddingVertical="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="@string/kicker"
                    android:textAllCaps="true"
                    android:textColor="@color/gold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="38sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/spinner"
                        style="@android:style/Widget.Material.ProgressBar.Small"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        android:indeterminateTint="@color/gold" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/finding"
                        android:textColor="@color/ink_dim"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/foundHeading"
                    style="@style/FireVerse.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/found_heading"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/tables"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/FireVerse.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/manual_heading" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/address"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/field_background"
                        android:hint="@string/manual_hint"
                        android:imeOptions="actionGo|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:nextFocusRight="@+id/connectButton"
                        android:paddingHorizontal="18dp"
                        android:singleLine="true"
                        android:textColor="@color/ink"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/connectButton"
                        style="@style/FireVerse.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:minWidth="140dp"
                        android:text="@string/connect" />
                </LinearLayout>

                <Button
                    android:id="@+id/retryButton"
                    style="@style/FireVerse.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/retry" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/footer"
                    android:textColor="#99C9B79B"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
